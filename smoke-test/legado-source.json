{
  "bookSourceName": "legado-local",
  "bookSourceUrl": "http://localhost:8090",
  "bookSourceType": 0,
  "bookUrlPattern": "/legado-book(\\d+)\\.html",
  "enabled": true,
  "ruleSearch": {
    "bookList": "class.book",
    "name": "tag.h3@text",
    "author": "class.author@text",
    "coverUrl": "tag.img@src",
    "bookUrl": "tag.a@href"
  },
  "ruleBookInfo": {
    "name": "tag.h1@text",
    "author": "class.author@text",
    "coverUrl": "@css:.cover img@src",
    "intro": "class.intro@text"
  },
  "ruleToc": {
    "chapterList": "@css:ul.catalog li",
    "chapterName": "tag.a@text",
    "chapterUrl": "tag.a@href"
  },
  "ruleContent": {
    "content": "id.content@html"
  },
  "searchUrl": "/legado-search.html?q={{key}}"
}
